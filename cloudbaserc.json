{
  "version": "2.0",
  "envId": "wenjin-cloudbase-d1empq882391ac1",
  "functionRoot": ".",
  "functions": [
    {
      "name": "lottery-ingest",
      "dir": "cloudbase",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 120,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "CLOUDBASE_ENV_ID": "wenjin-cloudbase-d1empq882391ac1",
        "CLOUDBASE_API_KEY": "{{env.CLOUDBASE_API_KEY}}",
        "JISU_APPKEY": "{{env.JISU_APPKEY}}",
        "APNS_KEY_P8": "{{env.APNS_KEY_P8}}",
        "APNS_KEY_ID": "{{env.APNS_KEY_ID}}",
        "APNS_TEAM_ID": "{{env.APNS_TEAM_ID}}",
        "APNS_TOPIC": "{{env.APNS_TOPIC}}"
      },
      "triggers": [],
      "ignore": [
        "node_modules/**",
        "test/**",
        "scripts/**",
        "migrations/**",
        "sql/**",
        "functions/**"
      ]
    },
    {
      "name": "lottery-api",
      "dir": "cloudbase",
      "handler": "api-index.main",
      "runtime": "Nodejs20.19",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "CLOUDBASE_ENV_ID": "wenjin-cloudbase-d1empq882391ac1",
        "CLOUDBASE_API_KEY": "{{env.CLOUDBASE_API_KEY}}",
        "LOTTERY_READ_API_KEY": "{{env.LOTTERY_READ_API_KEY}}",
        "LOTTERY_USER_API_KEY": "{{env.LOTTERY_USER_API_KEY}}"
      },
      "triggers": [],
      "ignore": [
        "node_modules/**",
        "test/**",
        "scripts/**",
        "migrations/**",
        "sql/**",
        "functions/**"
      ]
    },
    {
      "name": "lottery-api-http",
      "dir": "cloudbase",
      "handler": "http-index.main",
      "type": "HTTP",
      "runtime": "Nodejs20.19",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "CLOUDBASE_ENV_ID": "wenjin-cloudbase-d1empq882391ac1",
        "CLOUDBASE_API_KEY": "{{env.CLOUDBASE_API_KEY}}",
        "LOTTERY_READ_API_KEY": "{{env.LOTTERY_READ_API_KEY}}",
        "LOTTERY_USER_API_KEY": "{{env.LOTTERY_USER_API_KEY}}"
      },
      "triggers": [],
      "ignore": [
        "node_modules/**",
        "test/**",
        "scripts/**",
        "migrations/**",
        "sql/**",
        "functions/**"
      ]
    }
  ]
}
